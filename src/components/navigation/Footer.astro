---
/**
 * Footer.astro
 * Site footer — nav links, social links, copyright.
 */

const navLinks = [
  { label: 'About',       href: '#about' },
  { label: 'Engineering', href: '#engineering' },
  { label: 'Projects',    href: '#projects' },
  { label: 'Skills',      href: '#skills' },
  { label: 'Experience',  href: '#experience' },
  { label: 'Contact',     href: '#contact' },
];

const year = new Date().getFullYear();
---

<footer class="site-footer" aria-label="Site footer">
  <div class="container">

    <div class="site-footer__inner">

      <div class="site-footer__brand">
        <a href="/" class="site-footer__wordmark" aria-label="Larna Campbell — back to top">
          <span class="site-footer__monogram" aria-hidden="true">LC</span>
          <span>Larna Campbell</span>
        </a>
        <p class="site-footer__tagline">
          Software engineer and educator building accessible, user-centred systems.
        </p>
      </div>

      <nav class="site-footer__nav" aria-label="Footer navigation">
        <ul role="list" class="site-footer__nav-list">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="site-footer__nav-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copyright">
        &copy; {year} Larna Campbell. Built with
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>.
      </p>
      <p class="site-footer__a11y">
        Designed with accessibility and inclusion in mind.
        <a href="#main-content" class="site-footer__back-to-top">Back to top</a>
      </p>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-grey-900);
    color: var(--color-grey-400);
    padding-block: var(--space-12) var(--space-8);
    border-top: var(--border-width) solid var(--color-grey-800);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    padding-bottom: var(--space-10);
    border-bottom: var(--border-width) solid rgb(255 255 255 / 0.08);
  }

  @media (min-width: 48em) {
    .site-footer__inner {
      grid-template-columns: 1fr auto;
      gap: var(--space-16);
      align-items: start;
    }
  }

  /* Brand */
  .site-footer__wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-white);
    font-weight: var(--weight-bold);
    font-size: var(--text-md);
    margin-bottom: var(--space-4);
    transition: color var(--transition-fast);
  }

  .site-footer__wordmark:hover {
    color: var(--color-accent-subtle);
    text-decoration: none;
  }

  .site-footer__monogram {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background-color: var(--color-accent);
    color: var(--color-text-on-dark); /* light text on dark background — 12.8:1 ✓ AAA */
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .site-footer__tagline {
    font-size: var(--text-sm);
    color: var(--color-grey-400);
    line-height: var(--leading-relaxed);
    max-width: 36ch;
    margin: 0;
  }

  /* Nav */
  .site-footer__nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-footer__nav-link {
    font-size: var(--text-sm);
    color: var(--color-grey-400);
    text-decoration: none;
    transition: color var(--transition-fast);
    display: inline-block;
    padding-block: var(--space-1);
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .site-footer__nav-link:hover {
    color: var(--color-white);
    text-decoration: none;
  }

  /* Bottom bar */
  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-6);
  }

  @media (min-width: 48em) {
    .site-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .site-footer__copyright,
  .site-footer__a11y {
    font-size: var(--text-sm);
    color: var(--color-grey-400);
    margin: 0;
    max-width: none;
  }

  .site-footer__copyright a,
  .site-footer__a11y a {
    color: var(--color-grey-400);
    text-decoration-color: var(--color-grey-600);
    transition: color var(--transition-fast);
  }

  .site-footer__copyright a:hover,
  .site-footer__a11y a:hover {
    color: var(--color-white);
  }

  .site-footer__back-to-top {
    margin-left: var(--space-4);
  }
</style>