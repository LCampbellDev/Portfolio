---
/**
 * Footer.astro
 * Site footer — nav links, social links, copyright.
 */

const navLinks = [
  { label: "About", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Skills", href: "#skills" },
  { label: "Experience", href: "#experience" },
  { label: "Tech Education", href: "#tech-education" },
  { label: "Contact", href: "#contact" },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__inner">
      <div class="site-footer__brand">
        <a href="/" class="site-footer__wordmark">
          <span class="site-footer__monogram" aria-hidden="true">LC</span>
          <span>L Campbell</span>
        </a>
        <p class="site-footer__tagline">
          Software engineer building accessible, user-centred systems.
        </p>
      </div>

      <nav class="site-footer__nav" aria-label="Page Sections">
        <ul role="list" class="site-footer__nav-list">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class="site-footer__nav-link">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__a11y">
        I aim to make this site accessible and meet at least WCAG 2.2 AA. If you
        find a barrier, please{" "}
        <a href="mailto:larna@lcampbell.dev">let me know.</a>
      </p>

      <a
        href="https://github.com/LCampbellDev/Portfolio"
        class="site-footer__source-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        Portfolio code on GitHub
        <span class="sr-only"> (opens in new tab)</span>
      </a>

      <div class="site-footer__meta">
        <p class="site-footer__copyright">
          &copy; {year} L Campbell. All rights reserved.
        </p>

        <a href="#top" class="site-footer__back-to-top">Back to top</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --footer-text-color: #b8b5af;
    --footer-heading-color: #f0efeb;
    --footer-link-color: #2dd4c8;

    background-color: var(--color-grey-900);
    color: var(--footer-text-color);
    padding-block: var(--space-12) var(--space-8);
    border-top: var(--border-width) solid var(--color-grey-800);
  }

  .site-footer__tagline,
  .site-footer__a11y,
  .site-footer__copyright {
    color: var(--footer-text-color);
  }

  .site-footer__a11y a,
  .site-footer__back-to-top {
    color: var(--footer-link-color);
    text-decoration-color: currentColor;
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    padding-bottom: var(--space-10);
    border-bottom: var(--border-width) solid rgb(255 255 255 / 0.08);
  }

  @media (min-width: 48em) {
    .site-footer__inner {
      grid-template-columns: 1fr auto;
      gap: var(--space-16);
      align-items: start;
    }
  }
  @media (min-width: 60em) {
    .site-footer__nav {
      display: none;
    }

    .site-footer__inner {
      grid-template-columns: 1fr;
    }
  }

  /* Brand */
  .site-footer__wordmark {
    color: var(--footer-heading-color);
  }

  .site-footer__tagline,
  .site-footer__a11y,
  .site-footer__copyright {
    color: var(--footer-text-color);
  }

  .site-footer__a11y a,
  .site-footer__back-to-top,
  .site-footer__source-link {
    color: var(--footer-link-color);
  }

  .site-footer__a11y a:hover,
  .site-footer__back-to-top:hover,
  .site-footer__source-link:hover {
    color: var(--footer-heading-color);
  }

  .site-footer__wordmark:hover {
    color: var(--color-accent-subtle);
    text-decoration: none;
  }

  .site-footer__monogram {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background-color: var(--color-accent);
    color: var(--color-text-on-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }
  .site-footer__tagline {
    font-size: var(--text-sm);
    color: var(--footer-text-color);
    line-height: var(--leading-relaxed);
    width: 100%;
    max-width: none;
    margin: 0;
  }

  /* Nav */
  .site-footer__nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-footer__nav-link {
    font-size: var(--text-sm);
    color: var(--color-grey-400);
    text-decoration: none;
    transition: color var(--transition-fast);
    display: inline-block;
    padding-block: var(--space-1);
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .site-footer__nav-link:hover {
    color: var(--color-white);
    text-decoration: none;
  }

  /* Bottom bar */
  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-6);
    text-align: center;
  }

  .site-footer__copyright,
  .site-footer__a11y {
    width: 100%;
    max-width: none;
    margin: 0;
    color: var(--footer-text-color);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    text-align: center;
  }
  .site-footer__copyright a,
  .site-footer__a11y a {
    color: var(--color-grey-400);
    text-decoration-color: var(--color-grey-600);
    transition: color var(--transition-fast);
  }

  .site-footer__copyright a:hover,
  .site-footer__a11y a:hover {
    color: var(--color-white);
  }

  .site-footer__back-to-top {
    color: var(--color-footer-link);
    text-decoration-color: currentColor;
    margin-left: 0;
    align-self: center;
  }

  .site-footer__back-to-top:hover {
    color: var(--color-white);
  }
  .site-footer__meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    margin-top: var(--space-2);
  }

  @media (min-width: 48em) {
    .site-footer__meta {
      flex-direction: row;
      justify-content: space-between;
    }

    .site-footer__copyright {
      width: auto;
      text-align: left;
    }

    .site-footer__back-to-top {
      align-self: auto;
    }
  }
</style>
