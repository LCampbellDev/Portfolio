---
/**
 * SiteHeader.astro
 *
 * Sticky site header (which disappears on high zoom so not obscuring text) with:
 * - Wordmark / name logo linking to homepage
 * - Desktop horizontal nav
 * - Mobile hamburger menu (accessible, keyboard-navigable)
 * - Active link highlighting
 *
 * Accessibility:
 * - <header> landmark with aria-label
 * - <nav> with aria-label
 * - Mobile button uses aria-expanded / aria-controls
 * - Mobile menu uses role="dialog" equivalent pattern via aria-hidden
 * - Focus trap within open mobile menu
 * - All nav links keyboard accessible
 * - Escape key closes mobile menu
 * - Visible focus rings (from global reset)
 */

const navLinks = [
  { label: "About", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Skills", href: "#skills" },
  { label: "Experience", href: "#experience" },
  { label: "Tech Education", href: "#tech-education" },
  { label: "Contact", href: "#contact" },
];
---

<header class="site-header" aria-label="Site header" id="site-header">
  <div class="site-header__inner container">
    <!-- Wordmark -->
    <a
      href="/"
      class="site-header__wordmark"
      aria-label="Larna Campbell — home"
    >
      <span class="site-header__wordmark-name" aria-hidden="true">LC</span>
      <span class="site-header__wordmark-full">L Campbell</span>
    </a>

    <!-- Desktop navigation -->
    <nav class="site-header__nav" aria-label="Main">
      <ul role="list" class="site-header__nav-list">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="site-header__nav-link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Theme toggle -->
    <button
      class="site-header__theme-btn"
      id="theme-toggle"
      aria-label="Switch to dark mode"
    >
      <!-- Sun icon — shown in dark mode -->
      <svg
        class="theme-icon theme-icon--sun"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
      <!-- Moon icon — shown in light mode -->
      <svg
        class="theme-icon theme-icon--moon"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>

      <span class="site-header__theme-text" id="theme-toggle-text">
        Dark mode
      </span>
    </button>

    <!-- Mobile menu toggle -->
    <button
      class="site-header__menu-btn"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open navigation menu"
      id="menu-toggle"
    >
      <span class="site-header__menu-icon" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
  </div>
</header>

<!-- Mobile menu — separate from header so it can overlay full screen -->
<div
  class="mobile-menu"
  id="mobile-menu"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
>
  <!-- Backdrop -->
  <div class="mobile-menu__backdrop" id="menu-backdrop" aria-hidden="true">
  </div>

  <!-- Panel -->
  <div class="mobile-menu__panel">
    <div class="mobile-menu__header">
      <span class="mobile-menu__title">Navigation</span>
      <button
        class="mobile-menu__close"
        id="menu-close"
        aria-label="Close navigation menu"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M4 4L16 16M16 4L4 16"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <nav aria-label="Mobile">
      <ul role="list" class="mobile-menu__nav-list">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="mobile-menu__nav-link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</div>

<script>
  /**
   * Mobile menu behaviour
   * - Toggle open/close
   * - Focus trap while open
   * - Escape key to close
   * - Click backdrop to close
   * - Close on nav link click
   * - Prevent body scroll while menu is open
   * - Announce state to screen readers via aria-expanded / aria-hidden
   */

  const toggle = document.getElementById("menu-toggle") as HTMLButtonElement;
  const closeBtn = document.getElementById("menu-close") as HTMLButtonElement;
  const menu = document.getElementById("mobile-menu") as HTMLElement;
  const backdrop = document.getElementById("menu-backdrop") as HTMLElement;
  const navLinks = menu.querySelectorAll<HTMLAnchorElement>(
    ".mobile-menu__nav-link",
  );

  // Focusable elements inside the panel for focus trapping
  const getFocusable = () =>
    Array.from(
      menu.querySelectorAll<HTMLElement>(
        'a[href], button, [tabindex]:not([tabindex="-1"])',
      ),
    ).filter((el) => !el.hasAttribute("disabled"));

  function openMenu() {
    menu.setAttribute("aria-hidden", "false");
    menu.classList.add("is-open");
    toggle.setAttribute("aria-expanded", "true");
    toggle.setAttribute("aria-label", "Close navigation menu");
    toggle.classList.add("is-active");
    document.body.style.overflow = "hidden";

    // Move focus to close button
    requestAnimationFrame(() => closeBtn.focus());
  }

  function closeMenu() {
    menu.setAttribute("aria-hidden", "true");
    menu.classList.remove("is-open");
    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute("aria-label", "Open navigation menu");
    toggle.classList.remove("is-active");
    document.body.style.overflow = "";

    // Return focus to toggle
    toggle.focus();
  }

  // Focus trap — cycle through focusable elements only
  function trapFocus(e: KeyboardEvent) {
    if (e.key !== "Tab") return;
    const focusable = getFocusable();
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (e.shiftKey) {
      if (document.activeElement === first) {
        e.preventDefault();
        last.focus();
      }
    } else {
      if (document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  }

  toggle.addEventListener("click", () => {
    const isOpen = menu.getAttribute("aria-hidden") === "false";
    isOpen ? closeMenu() : openMenu();
  });

  closeBtn.addEventListener("click", closeMenu);
  backdrop.addEventListener("click", closeMenu);

  // Close on nav link click (single-page anchor navigation)
  navLinks.forEach((link) => link.addEventListener("click", closeMenu));

  // Keyboard: Escape closes, Tab is trapped
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu.classList.contains("is-open")) {
      closeMenu();
    }
    if (menu.classList.contains("is-open")) {
      trapFocus(e);
    }
  });

  // Scroll behaviour — add scrolled class to header
  const header = document.getElementById("site-header") as HTMLElement;
  const SCROLL_THRESHOLD = 20;

  function handleScroll() {
    if (window.scrollY > SCROLL_THRESHOLD) {
      header.classList.add("is-scrolled");
    } else {
      header.classList.remove("is-scrolled");
    }
  }

  // Use passive listener for scroll performance
  window.addEventListener("scroll", handleScroll, { passive: true });
  handleScroll(); // Run once on load

  // --------------------------------------------------------
  // Theme toggle
  // --------------------------------------------------------
  const themeBtn = document.getElementById("theme-toggle") as HTMLButtonElement;

  const themeText = themeBtn.querySelector(
    ".site-header__theme-text",
  ) as HTMLSpanElement;

  function getTheme(): string {
    return document.documentElement.getAttribute("data-theme") ?? "light";
  }

  function updateToggleLabel(theme: string) {
    const nextTheme = theme === "dark" ? "light" : "dark";
    const visibleLabel = nextTheme === "light" ? "Light mode" : "Dark mode";

    themeBtn.setAttribute("aria-label", `Switch to ${nextTheme} mode`);
    themeText.textContent = visibleLabel;
  }

  function toggleTheme() {
    const current = getTheme();
    const next = current === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    localStorage.setItem("theme", next);
    updateToggleLabel(next);
  }

  themeBtn.addEventListener("click", toggleTheme);

  // Set correct label on load
  updateToggleLabel(getTheme());
</script>

<style>
  /* ============================================================
   * SITE HEADER
   * ============================================================ */

  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background-color: var(--color-bg);
    border-bottom: var(--border-width) solid transparent;
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  /* Scrolled state — reveal border + subtle shadow */
  .site-header.is-scrolled {
    border-bottom-color: var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
    gap: clamp(var(--space-4), 2vw, var(--space-8));
  }

  /* ----------------------------------------------------------
   * WORDMARK
   * ---------------------------------------------------------- */

  .site-header__wordmark {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-text-heading);
    font-weight: var(--weight-bold);
    font-size: var(--text-md);
    letter-spacing: var(--tracking-tight);
    flex-shrink: 0;
    transition: color var(--transition-fast);
  }

  .site-header__wordmark:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  /* Two-letter monogram badge */
  .site-header__wordmark-name {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background-color: var(--color-accent);
    color: var(--color-text-on-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .site-header__wordmark-full {
    /* Hidden at small sizes, shown at medium+ */
    display: none;
  }

  @media (min-width: 36em) {
    .site-header__wordmark-full {
      display: block;
    }
  }

  @media (max-width: 30em) and (hover: hover) and (pointer: fine) {
    .site-header {
      position: static;
    }
  }

  /* ----------------------------------------------------------
   * DESKTOP NAVIGATION
   * ---------------------------------------------------------- */

  .site-header__nav {
    display: none; /* Hidden on mobile */
    margin-left: auto;
  }

  @media (min-width: 60em) {
    .site-header__nav {
      display: block;
    }
  }

  .site-header__nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
  }

  .site-header__nav-link {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: var(--radius-md);
    border: var(--border-width) solid transparent;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);

    white-space: nowrap;
  }

  .site-header__nav-link:hover {
    color: var(--color-accent);
    background-color: var(--color-accent-light);
    text-decoration: none;
  }

  .site-header__nav-link[aria-current="page"] {
    color: var(--color-accent);
    font-weight: var(--weight-bold);
  }

  /* ----------------------------------------------------------
   * MOBILE MENU TOGGLE BUTTON
   * ---------------------------------------------------------- */

  .site-header__menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem; /* 44px — minimum touch target */
    height: 2.75rem;
    padding: 0;
    background: none;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    color: var(--color-text);
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast);
    flex-shrink: 0;
  }

  .site-header__menu-btn:hover {
    border-color: var(--color-accent);
    background-color: var(--color-accent-light);
    color: var(--color-accent);
  }

  /* Hide on desktop */
  @media (min-width: 60em) {
    .site-header__menu-btn {
      display: none;
    }
  }

  /* ----------------------------------------------------------
   * THEME TOGGLE BUTTON
   * ---------------------------------------------------------- */

  .site-header__theme-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: auto;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding-inline: var(--space-3);
    background: none;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    color: var(--color-text);
    white-space: nowrap;
    flex-shrink: 0;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .site-header__theme-text {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .site-header__theme-btn:hover {
    border-color: var(--color-accent);
    background-color: var(--color-accent-light);
    color: var(--color-accent);
  }

  /* Show correct icon based on current theme */
  .theme-icon--sun {
    display: none;
  }
  .theme-icon--moon {
    display: block;
  }

  :global([data-theme="dark"]) .theme-icon--sun {
    display: block;
  }
  :global([data-theme="dark"]) .theme-icon--moon {
    display: none;
  }

  /* Hamburger icon — three spans animate to X */
  .site-header__menu-icon {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 18px;
  }

  .site-header__menu-icon span {
    display: block;
    height: 2px;
    background-color: currentColor;
    border-radius: var(--radius-full);
    transform-origin: center;
    transition:
      transform var(--transition-base),
      opacity var(--transition-fast);
  }

  @media (forced-colors: active) {
    .site-header__menu-icon span {
      background-color: ButtonText;
      forced-color-adjust: none;
    }
  }

  /* Active (X) state */
  .site-header__menu-btn.is-active .site-header__menu-icon span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .site-header__menu-btn.is-active .site-header__menu-icon span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .site-header__menu-btn.is-active .site-header__menu-icon span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__menu-icon span {
      transition: none;
    }
  }

  /* ============================================================
   * MOBILE MENU
   * ============================================================ */

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-header) + 1);
    pointer-events: none;
    visibility: hidden;
  }

  .mobile-menu.is-open {
    pointer-events: auto;
    visibility: visible;
  }

  /* Backdrop */
  .mobile-menu__backdrop {
    position: absolute;
    inset: 0;
    background-color: rgb(26 25 23 / 0.4);
    opacity: 0;
    transition: opacity var(--transition-slow);
  }

  .mobile-menu.is-open .mobile-menu__backdrop {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu__backdrop {
      transition: none;
    }
  }

  /* Panel — slides in from right */
  .mobile-menu__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(18rem, 85vw);
    background-color: var(--color-bg);
    border-left: var(--border-width) solid var(--color-border);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform var(--transition-slow);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mobile-menu.is-open .mobile-menu__panel {
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu__panel {
      transition: none;
    }
  }

  /* Mobile menu header row */
  .mobile-menu__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-6);
    border-bottom: var(--border-width) solid var(--color-border);
    min-height: 4rem;
  }

  .mobile-menu__title {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  /* Close button */
  .mobile-menu__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: none;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    color: var(--color-text);
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .mobile-menu__close:hover {
    border-color: var(--color-accent);
    background-color: var(--color-accent-light);
    color: var(--color-accent);
  }

  /* Mobile nav links */
  .mobile-menu__nav-list {
    list-style: none;
    padding: var(--space-4) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .mobile-menu__nav-link {
    display: flex;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-md);
    border: var(--border-width) solid transparent;
    min-height: 44px; /* Touch target */
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .mobile-menu__nav-link:hover {
    color: var(--color-accent);
    background-color: var(--color-accent-light);
    text-decoration: none;
  }
</style>
