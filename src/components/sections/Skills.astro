---
/**
 * Skills.astro
 * Grouped skills: Languages, Frameworks, Databases, Testing,
 * Accessibility, Tools & Delivery.
 */
 
const skillGroups = [
  {
    heading: 'Programming & web Technologies',
    skills: [
      'JavaScript',
      'TypeScript',
      'HTML',
      'CSS',
      'React',
      'Next.js',
      'Astro',
      'Node.js',
      'Express',
      'Python',
      'FastAPI',
      'Flask',
    ],
  },
  {
    heading: 'Data and APIs',
    skills: [
      'SQL', 
      'MySQL', 
      'Database design', 
      'Data security', 
      'Password hashing', 
      'Parameterised queries', 
      'REST APIs', 
      'API integration', 
      'API design', 
      'Input validation', 
      'Error handling'
    ],
  },
  {
    heading: 'Testing & quality',
    skills: [
      'Unit testing', 
      'Integration testing', 
      'End-to-end testing', 
      'Regression testing', 
      'Accessibility testing', 
      'React Testing Library', 
      'Jest', 
      'Pytest', 
      'Python unittest', 
      'ESLint', 
      'Prettier'  
    ],
  },
  {
    heading: 'DevOps & Cloud',
    skills: [
      'AWS: S3, EC2, ECR and ECS',
      'Azure fundamentals',
      'Docker Containerisation',
      'Kubernetes', 
      'Terraform',
      'CI/CD',
      'GitHub Actions',
      'Vercel',
      'Infrastructure fundamentals',
    ],
  },
  {
    heading: 'Accessibility & design',
    skills: [
      'WCAG 2.2', 
      'WCAG 3 draft awareness', 
      'Semantic HTML', 
      'ARIA', 
      'Keyboard navigation', 
      'Screen reader testing',
      'Cognitive accessibility', 
      'Lighthouse', 
      'GOV.UK Design System', 
      'User research with disabled users'
    ],
  },
  {
    heading: 'Tools & delivery',
    skills: [
      'Git', 
      'GitHub', 
      'Postman', 
      'Agile', 
      'Jira', 
      'ClickUp', 
      'VS Code', 
      'Pair and group programming', 
      'Pull requests', 
      'Code review', 
      'Technical documentation'
    ],
  },
  
];
---
 
<section class="skills section section--muted" id="skills">
  <div class="container">
 
    <div class="section-header">
      <h2 class="section-header__title">
        Technical skills
      </h2>
      <div class="divider" aria-hidden="true"></div>
    </div>
 
    <dl class="skills__grid">
      {skillGroups.map((group) => (
        <div class="skills__group">
          <dt class="skills__group-heading">{group.heading}</dt>
          <dd class="skills__group-tags">
            <ul role="list" class="skills__tag-list">
              {group.skills.map((skill) => (
                <li><span class="tag">{skill}</span></li>
              ))}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
 
  </div>
</section>
 
<style>
  .skills__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }
 
  @media (min-width: 36em) {
    .skills__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
 
  @media (min-width: 60em) {
    .skills__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
 
  .skills__group {
    padding: var(--space-6);
    background-color: var(--color-bg-subtle);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    min-width: 0;
    max-width: 100%;
  }
 
  .skills__group-heading {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }
 
  .skills__group-tags {
    margin: 0;
  }
 
  .skills__tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    min-width: 0;
    max-width: 100%;
  }
</style>
