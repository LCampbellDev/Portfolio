---
/**
 * Skills.astro
 * Grouped skills: Languages, Frameworks, Databases, Testing,
 * Accessibility, Tools & Delivery.
 */
 
const skillGroups = [
  {
    heading: 'Languages',
    skills: ['JavaScript', 'TypeScript', 'Python', 'SQL', 'HTML', 'CSS'],
  },
  {
    heading: 'Frameworks & libraries',
    skills: ['React', 'Astro', 'Node.js', 'Express', 'FastAPI', 'Next.js']
  },
  {
    heading: 'Databases',
    skills: ['SQL', 'MySQL', 'MongoDB']
  },
  {
    heading: 'Testing',
    skills: ['React Testing Library', 'Jest', 'Supertest','Pytest', 'Python unittest']
  },
  {
  heading: 'Cloud & DevOps',
  skills: [
    'AWS fundamentals',
    'Cloud computing',
    'Docker',
    'Containerisation',
    'Linux CLI',
    'CI/CD',
    'Vercel',
  ],
},
  {
    heading: 'Accessibility',
    skills: ['WCAG 2.2', 'ARIA', 'Keyboard navigation', 'Screen reader testing', 'Focus management','Cognitive accessibility', 'Lighthouse', 'GOV.UK Design System', 'User research and testing with disabled users'],
  },
  {
    heading: 'Tools & delivery',
    skills: ['Git', 'GitHub', 'Postman', 'Agile', 'Jira', 'ClickUp', 'Figma', 'VS Code', 'API integration', 'REST APIs'],  },
];
---
 
<section class="skills section" id="skills" aria-labelledby="skills-heading">
  <div class="container">
 
    <div class="section-header">
      <p class="eyebrow">Skills</p>
      <h2 class="section-header__title" id="skills-heading">Technical skills</h2>
      <div class="divider" aria-hidden="true"></div>
    </div>
 
    <dl class="skills__grid">
      {skillGroups.map((group) => (
        <div class="skills__group">
          <dt class="skills__group-heading">{group.heading}</dt>
          <dd class="skills__group-tags">
            <ul role="list" class="skills__tag-list">
              {group.skills.map((skill) => (
                <li><span class="tag">{skill}</span></li>
              ))}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
 
  </div>
</section>
 
<style>
  .skills__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }
 
  @media (min-width: 36em) {
    .skills__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
 
  @media (min-width: 60em) {
    .skills__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
 
  .skills__group {
    padding: var(--space-6);
    background-color: var(--color-bg-subtle);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
  }
 
  .skills__group-heading {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }
 
  .skills__group-tags {
    margin: 0;
  }
 
  .skills__tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }
</style>
