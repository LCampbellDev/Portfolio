---
/**
 * Contact.astro
 * Contact section — email, LinkedIn, GitHub links.
 * No form to keep setup simple per the brief.
 */
---

<section
  class="contact section section--muted"
  id="contact"
  aria-labelledby="contact-heading"
>
  <div class="container">
    <div class="section-header">
      <h2 class="section-header__title" id="contact-heading">Get in touch</h2>
      <div class="divider" aria-hidden="true"></div>
      <p class="section-header__description">
        I’m always happy to connect with people working on accessible,
        user-focused technology. I welcome conversations about inclusive design
        and development.
      </p>
    </div>

    <address class="contact__inner">
      <ul class="contact__links">
        <li>
          <a href="mailto:larna@lcampbell.dev" class="contact__link">
            <span class="contact__link-icon" aria-hidden="true">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="M2 7l10 7 10-7"></path>
              </svg>
            </span>

            <div class="contact__link-text">
              <span class="contact__link-label">Email</span>
              <span class="contact__link-value">larna@lcampbell.dev</span>
            </div>
          </a>
        </li>

        <li>
          <a
            href="https://linkedin.com/in/larna-campbell"
            class="contact__link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact__link-icon" aria-hidden="true">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                ></path>
              </svg>
            </span>

            <div class="contact__link-text">
              <span class="contact__link-label">LinkedIn</span>
              <span class="contact__link-value">Larna Campbell</span>
            </div>

            <span class="sr-only"> (opens in new tab)</span>
          </a>
        </li>

        <li>
          <a
            href="https://github.com/LCampbellDev/"
            class="contact__link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact__link-icon" aria-hidden="true">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                ></path>
              </svg>
            </span>

            <div class="contact__link-text">
              <span class="contact__link-label">GitHub</span>
              <span class="contact__link-value">LCampbellDev</span>
            </div>

            <span class="sr-only"> (opens in new tab)</span>
          </a>
        </li>

        <li>
          <a
            href="https://lcampbelldev.github.io/fluentkin/"
            class="contact__link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact__link-icon" aria-hidden="true">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 4h16v2H4z"></path>
                <path d="M4 9h16v2H4z"></path>
                <path d="M4 14h16v7l-8-4-8 4v-7z"></path>
              </svg>
            </span>

            <div class="contact__link-text">
              <span class="contact__link-label">Blog</span>
              <span class="contact__link-value">FluentKin</span>
            </div>

            <span class="sr-only"> (opens in new tab)</span>
          </a>
        </li>
      </ul>
    </address>
  </div>
</section>

<style>
  .contact__inner {
    font-style: normal;
    width: 100%;
    min-width: 0;
    max-width: 36rem;
  }

  .contact__links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
    min-width: 0;
    margin: 0;
    padding: 0;
  }

  .contact__link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: clamp(var(--space-3), 4vw, var(--space-6));
    background-color: var(--color-bg) /*(--color-bg-card)*/;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--color-text);
    min-height: 44px;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      background-color var(--transition-fast);
  }

  .contact__link:hover {
    border-color: var(--color-accent-subtle);
    background-color: var(--color-accent-light);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: var(--color-text);
  }

  .contact__link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    color: var(--color-accent);
    background-color: var(--color-accent-light);
    border: var(--border-width) solid var(--color-accent-subtle);
    border-radius: var(--radius-md);
  }

  .contact__link-text {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-width: 0;
    max-width: 100%;
  }

  .contact__link-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-secondary);
    min-width: 0;
    max-width: 100%;
  }

  .contact__link-value {
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-text-heading);
    display: block;
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  @media (max-width: 30em) {
    .contact__link {
      flex-direction: column;
      align-items: center;
      padding: var(--space-4);
      text-align: center;
    }

    .contact__link-text {
      align-items: center;
      text-align: center;
    }
  }
</style>
