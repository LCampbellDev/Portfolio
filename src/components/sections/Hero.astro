---
/**
 * Hero.astro
 * Homepage hero section.
 * Name, role, value proposition, primary CTA links.
 */
---

<section class="hero section" aria-labelledby="hero-heading">
  <div class="container">
    <div class="hero__inner">

      <div class="hero__content">
        <p class="eyebrow">Full-Stack Software Engineer</p>

        <h1 class="hero__heading" id="hero-heading">
          Larna<br />Campbell
        </h1>

        <div class="divider" aria-hidden="true"></div>

        <p class="hero__lead">
          Building accessible, user-centred systems that make complex data
          clearer, more usable, and easier to work with.
        </p>

        <nav class="hero__links" aria-label="Primary links">
          <a href="#contact" class="btn btn--primary">Get in touch</a>
          <a href="#projects" class="btn btn--secondary">View projects</a>
        </nav>

        <ul class="hero__social" role="list" aria-label="Social and professional profiles">
          <li>
            <a
              href="https://github.com/LCampbellDev/"
              class="hero__social-link"
              aria-label="GitHub profile (opens in new tab)"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              GitHub
            </a>
          </li>
          <li>
            <a
              href="https://linkedin.com/in/larnacampbell"
              class="hero__social-link"
              aria-label="LinkedIn profile (opens in new tab)"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn
            </a>
          </li>
          <li>
            <a
              href="mailto:larna@lcampbell.dev"
              class="hero__social-link"
              aria-label="Send email to larna@lcampbell.dev"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="M2 7l10 7 10-7"/>
              </svg>
              Email
            </a>
          </li>
          <li>
            <a
              href="https://lcampbelldev.github.io/fluentkin/"
              class="hero__social-link"
              aria-label="Visit my blog on FluentKin (opens in new tab)"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 4h16v2H4z"/>
                <path d="M4 9h16v2H4z"/>
                <path d="M4 14h16v7l-8-4-8 4v-7z"/>
              </svg>
              Blog
            </a>
          </li>
        </ul>
      </div>

      <!-- Avatar -->
      <div class="hero__avatar" aria-hidden="false">
        <img
          src="/avatar.png"
          alt="Illustrated portrait of Larna Campbell, smiling, wearing glasses and a black t-shirt with a rainbow logo, against a teal and purple gradient background"
          class="hero__avatar-img"
          width="280"
          height="280"
          loading="eager"
        />
      </div>

    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-20) var(--space-24);
    background-color: var(--color-bg);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  @media (min-width: 48em) {
    .hero {
      padding-block: var(--space-24) var(--space-32);
    }
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 56em) {
    .hero__inner {
      grid-template-columns: 1fr auto;
      gap: var(--space-16);
    }
  }

  /* Heading */
  .hero__heading {
    font-size: var(--text-hero);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-heading);
    line-height: var(--leading-tight);
    margin-top: var(--space-4);
  }

  /* Lead paragraph */
  .hero__lead {
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    max-width: 44ch;
  }

  /* CTA buttons */
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  /* Social / profile links */
  .hero__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-8);
    list-style: none;
  }

  .hero__social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    text-decoration: none;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    min-height: 44px;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .hero__social-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent-subtle);
    background-color: var(--color-accent-light);
    text-decoration: none;
  }

  /* Avatar */
  .hero__avatar {
    display: none;
  }

  @media (min-width: 56em) {
    .hero__avatar {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
  }

  .hero__avatar-img {
    width: 16rem;
    height: 16rem;
    border-radius: var(--radius-xl);
    object-fit: cover;
    object-position: center top;
    border: 3px solid var(--color-accent-subtle);
    box-shadow: var(--shadow-lg);
  }
</style>