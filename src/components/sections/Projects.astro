---
/**
 * Projects.astro
 * Three featured project cards.
 * Equal height on desktop, stacked on mobile.
 */

const projects = [
  {
    title: 'AccessMap',
    summary:
    'A data-driven web application that visualises accessibility information for public spaces, helping users with disabilities plan routes with confidence.',
    problem: 'Accessibility data exists but is scattered and hard to act on.',
    stack: ['Python', 'FastAPI', 'PostgreSQL', 'React', 'Leaflet'],
    github: 'https://github.com/larnacampbell/accessmap',
    demo: null,
  },
  {
    title: 'ClearForm',
    summary:
    'An accessible form builder that generates WCAG-compliant HTML forms with built-in validation, clear error messaging, and screen reader support.',
    problem: 'Most form tools produce inaccessible markup by default.',
    stack: ['TypeScript', 'Node.js', 'Express', 'PostgreSQL', 'Jest'],
    github: 'https://github.com/larnacampbell/clearform',
    demo: 'https://clearform.lcampbell.dev',
  },
  {
    title: 'DataLens',
    summary:
    'A dashboard tool for educators that surfaces student progress data in a low-cognitive-load interface, reducing the time spent interpreting spreadsheets.',
    problem: 'Raw data in spreadsheets creates barriers for busy educators.',
    stack: ['Python', 'Django', 'SQLite', 'Chart.js', 'Pytest'],
    github: 'https://github.com/larnacampbell/datalens',
    demo: null,
  },
];
---
 
<section class="projects section section--muted" id="projects" aria-labelledby="projects-heading">
  <div class="container">
 
    <div class="section-header">
      <p class="eyebrow">Work</p>
      <h2 class="section-header__title" id="projects-heading">Featured projects</h2>
      <div class="divider" aria-hidden="true"></div>
      <p class="section-header__description">
        A selection of full-stack projects built to solve real problems, with
        accessibility and usability at the centre.
      </p>
    </div>
 
    <ul class="projects__grid" role="list">
      {projects.map((project) => (
        <li class="card projects__card">
 
          <div class="projects__card-body">
            <h3 class="projects__card-title">{project.title}</h3>
            <p class="projects__card-summary">{project.summary}</p>
 
            <div class="projects__card-problem">
              <span class="label label--muted">Problem</span>
              <p>{project.problem}</p>
            </div>
          </div>
 
          <footer class="projects__card-footer">
            <ul class="projects__tags" role="list" aria-label={`Technologies used in ${project.title}`}>
              {project.stack.map((tech) => (
                <li><span class="tag">{tech}</span></li>
              ))}
            </ul>
 
            <nav class="projects__card-links" aria-label={`${project.title} links`}>
              {project.github && (
                <a
                  href={project.github}
                  class="btn btn--ghost projects__card-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`View ${project.title} source code on GitHub (opens in new tab)`}
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                  </svg>
                  GitHub
                </a>
              )}
              {project.demo && (
                <a
                  href={project.demo}
                  class="btn btn--secondary projects__card-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`View live demo of ${project.title} (opens in new tab)`}
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
                    <polyline points="15 3 21 3 21 9"/>
                    <line x1="10" y1="14" x2="21" y2="3"/>
                  </svg>
                  Live demo
                </a>
              )}
            </nav>
          </footer>
 
        </li>
      ))}
    </ul>
 
  </div>
</section>
 
<style>
  .projects__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    list-style: none;
  }
 
  @media (min-width: 48em) {
    .projects__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
 
  /* Equal height — card uses flex column to push footer down */
  .projects__card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
  }
 
  .projects__card-body {
    flex: 1;
  }
 
  .projects__card-title {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-text-heading);
    margin-bottom: var(--space-3);
  }
 
  .projects__card-summary {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: none;
    margin: 0;
  }
 
  .projects__card-problem {
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
  }
 
  .projects__card-problem .label {
    margin-bottom: var(--space-2);
  }
 
  .projects__card-problem p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    max-width: none;
    margin: 0;
    line-height: var(--leading-normal);
  }
 
  .projects__card-footer {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
 
  .projects__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }
 
  .projects__card-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
 
  .projects__card-link {
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-4);
  }
</style>