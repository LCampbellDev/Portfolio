---
/**
 * Experience.astro
 * Professional experience — education leadership, software/project work,
 * transferable systems and delivery experience.
 */
 
const experience = [
  {
    role: 'Software Engineer',
    org: 'Independent Software Engineering Projects',
    period: '2023 — Present',
    type: 'Software & Engineering',
    highlights: [
      'Designing and building full-stack applications using JavaScript, React, Node.js, Python and SQL',
      'Developing RESTful APIs and structured data systems',
      'Applying testing, accessibility, and secure coding practices',
      'Building modular, maintainable architectures using iterative delivery approaches',
      'Designing systems focused on usability, clarity, and real-world workflows'
    ],
  },
  {
    role: 'Head of Modern Foreign Languages',
    org: 'Leeds City Council',
    period: '2017 — present',
    type: 'Education Leadership',
    highlights: [
      'Led department-wide improvement initiatives using structured analysis and iterative problem solving',
      'Designed systems and workflows to improve consistency, communication, and operational efficiency',
      'Analysed performance and behavioural data to inform strategic decision-making',
      'Achieved a substantial% reduction in serious behaviour incidents through data-informed process improvements',
      'Collaborated with multidisciplinary stakeholders and communicated complex information clearly'
    ],
  },
  {
    role: 'MA Digital Education',
    org: 'University of Leeds',
    period: '2020 — 2023',
    /*type: 'Education',*/
    highlights: [
      'Research-informed study of digital systems, accessibility, learning design, and user-centred technology.',

      'Focused on education product development and how structured information, usability, and interface design affect understanding, participation, and decision-making.

      'Alongside digital pedagogy, learning theory, accessibility, and digital literacy.' 
  },
];
---
 
<section class="experience section" id="experience" aria-labelledby="experience-heading">
  <div class="container">
 
    <div class="section-header">
      <p class="eyebrow">Background</p>
      <h2 class="section-header__title" id="experience-heading">Experience</h2>
      <div class="divider" aria-hidden="true"></div>
    </div>
 
    <ol class="experience__list" role="list">
      {experience.map((item) => (
        <li class="experience__item">
          <div class="experience__meta">
            <span class="tag">{item.type}</span>
            <time class="experience__period">{item.period}</time>
          </div>
          <div class="experience__content">
            <h3 class="experience__role">{item.role}</h3>
            <p class="experience__org">{item.org}</p>
            <ul class="experience__highlights" role="list">
              {item.highlights.map((point) => (
                <li class="experience__highlight">{point}</li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
 
  </div>
</section>
 
<style>
  .experience__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
 
  .experience__item {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    padding-block: var(--space-8);
    border-top: var(--border-width) solid var(--color-border);
  }
 
  .experience__item:last-child {
    border-bottom: var(--border-width) solid var(--color-border);
  }
 
  @media (min-width: 48em) {
    .experience__item {
      grid-template-columns: 14rem 1fr;
      gap: var(--space-10);
      align-items: start;
    }
  }
 
  /* Meta column */
  .experience__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-1);
  }
 
  .experience__period {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    font-weight: var(--weight-medium);
  }
 
  /* Content column */
  .experience__role {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-text-heading);
    margin-bottom: var(--space-1);
  }
 
  .experience__org {
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-weight: var(--weight-medium);
    margin: 0 0 var(--space-4);
    max-width: none;
  }
 
  .experience__highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
 
  .experience__highlight {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    padding-left: var(--space-4);
    position: relative;
  }
 
  .experience__highlight::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent-subtle);
  }
</style>
 