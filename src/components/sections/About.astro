---
/**
 * About.astro
 * About section — professional summary, career story, values.
 * Tech-first framing with education as a strength.
 */

const storyParagraphs = [
  'Hi, I’m Larna,',
  'A full-stack software engineer based in the UK.',
  'My earlier career covered education leadership and digital learning design. That work strengthened my interest in systems, communication and clear information.',
  'During my MA in Digital Education, I especially enjoyed designing digital products. I wanted to build systems from scratch, without the limits of fixed platforms.',
  'Learning software engineering gave me that opportunity. I loved the creativity and challenge of building, testing and debugging software.',
  'I now build applications with JavaScript, TypeScript, React, Node.js, Python and SQL. I focus on accessible software that works under real-world pressure and cognitive load.',
];

const principles = [
  'Systems thinking',
  'Clear communication',
  'Collaborative problem-solving',
  'Inclusion by design',
  'Reducing friction',
  'Clear, maintainable code',
  'Tech stack flexibility',
];

---
 
<section class="about section section--muted" id="about" aria-labelledby="about-heading">
  <div class="container">
 
    <div class="section-header">
      <h2 class="section-header__title" id="about-heading">
        From education to software engineering
      </h2>
      <div class="divider" aria-hidden="true"></div>
    </div>
 

    <div class="about__grid">
 
      <div class="about__primary">
    <div class="about__story">
    {storyParagraphs.map((paragraph) => (
    <p>{paragraph}</p>
  ))}
    </div>
  </div>      
 
      <aside class="about__how_i_work"  aria-label="Core values"> 
        <h3 class="about__values-heading">Core principles</h3>
        <ul role="list" class="about__values-list">
  {principles.map((principle) => (
    <li class="about__value">
      <span class="about__value-icon" aria-hidden="true">⬡</span>

      <div>
        <strong>{principle}</strong>
      </div>
    </li>
  ))}
</ul>
      </aside>
 
    </div>
  </div>
</section>
 
<style>
  .about__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }
 
 @media (min-width: 56em) {
  .about__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-16);
    align-items: start;
    }
  }
 
  /* Primary text */
  .about__primary p {
    max-width: 60ch;
  }

  .about__story {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.about__story p {
  max-width: 65ch;
  margin: 0;
}
 
  /* Values sidebar */
  .about__values {
    background-color: var(--color-white);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }
 
  .about__values-heading {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-5);
  }
 
  .about__values-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    list-style: none;
  }
 
  .about__value {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }
 
  .about__value-icon {
    color: var(--color-accent);
    font-size: var(--text-md);
    line-height: 1.4;
    flex-shrink: 0;
  }
 
  .about__value strong {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-text-heading);
    margin-bottom: var(--space-1);
  }
 
  .about__value p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    max-width: none;
    margin: 0;
  }
</style>
 
